---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Rachel Reid">
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist.</h1>
    <p>It may have moved. Everything I've worked on is on the homepage.</p>
    <a class="btn btn-primary" href="/">See my work</a>
  </section>
</Base>

<style>
  .nf { padding-top: var(--s-9); display: grid; gap: var(--s-4); justify-items: start; }
  .nf p:not(.eyebrow) { max-width: 46ch; }
</style>
