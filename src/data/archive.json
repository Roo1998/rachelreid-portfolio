  "honours-project-walkthrough": [
    {
      "type": "image",
      "src": "/images/archive/honours-project-walkthrough/01.jpg"
    },
    {
      "type": "text",
      "lines": [
        "'Walkthrough' is an interactive audio guide for museums, designed for people who have a sensory processing disorder (SPD), with the aim of reducing the risk of sensory overload.",
        "'Walkthrough' works by registering for a card, which is brought every time while visiting a museum. Users tap their card on the readers next to the exhibits and it will give audio information to the user's personal Bluetooth headphones.  The content and amount of information given to the user will vary based on age, disabilities, and language preferences."
      ]
    },
    {
      "type": "image",
      "src": "/images/archive/honours-project-walkthrough/02.jpg"
